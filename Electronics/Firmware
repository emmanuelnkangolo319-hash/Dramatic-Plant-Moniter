//Level of ideal moisture for the most common house plants, if your plant isnt on here, paste this code into your favorite A.I 
//and ask what level your plant is at:
// Ideal moisture thresholds (0-100 scale, matching mapped sensor %):
//
// • Aloe Vera (Aloe barbadensis): 9% — Needs dry soil most of the time.
// • Haworthia / Zebra Plant: 11% — Thrives with minimal water and fast-draining mix.
// • Snake Plant (Dracaena trifasciata): 12% — Prefers soil to dry out completely between waterings.
// • Jade Plant (Crassula ovata): 13% — Wants deep, infrequent watering only after fully drying.
// • ZZ Plant (Zamioculcas zamiifolia): 14% — Stores water in rhizomes and dislikes staying damp.
// • String of Pearls / String of Hearts: 16% — Needs dry intervals to prevent root rot.
// • Cast Iron Plant (Aspidistra elatior): 36% — Likes soil to dry mostly out before watering again.
// • Pothos (Epipremnum aureum): 42% — Thrives when the top half of the soil dries between waterings.
// • Spider Plant (Chlorophytum comosum): 48% — Enjoys moderate moisture without soggy roots.
// • Rubber Plant (Ficus elastica): 49% — Likes evenly light moisture with the top couple inches drying out.
// • Chinese Money Plant (Pilea peperomioides): 50% — Prefers a balanced wet-to-dry cycle.
// • Heartleaf Philodendron (Philodendron hederaceum): 51% — Does best with moderate moisture and slight drying on top.
// • Monstera (Monstera deliciosa): 54% — Appreciates steady moisture in well-draining soil.
// • Fiddle Leaf Fig (Ficus lyrata): 58% — Prefers consistent, moderate moisture without sitting in water.
// • Moth Orchid (Phalaenopsis): 62% — Likes airy moisture and high humidity rather than wet soil.
// • Peace Lily (Spathiphyllum): 76% — Prefers consistently moist soil and wilts quickly when dry.
// • Prayer Plant (Maranta / Calathea): 82% — Needs evenly damp soil and high air humidity.
// • Boston Fern (Nephrolepis exaltata): 89% — Craves constant moisture in both soil and air.


void loop() {
 roboEyes.update();

  int analogValue = analogRead(sensorPin);
  int moisture = map(analogValue, DRY_RAW, WET_RAW, 0, 100);
  moisture = constrain(moisture, 0, 100);

  PlantMood currentMood;
  if (moisture >= 40) {
    currentMood = MOOD_HAPPY;
    roboEyes.setMood(HAPPY);
  } else if (moisture > 20 ) {
    currentMood = MOOD_ANGRY;
    roboEyes.setMood(ANGRY);
  } else {
    currentMood = MOOD_TIRED;
    roboEyes.setMood(TIRED);
  }

  unsigned long now = millis();
  bool moodChanged = (currentMood != lastMood);

  if (currentMood == MOOD_HAPPY) {
    if (moodChanged) {
      playHappy(); // celebratory chirp when watered
      lastReminderMs = now;
    }
  } else {
    // Needs water (ANGRY or TIRED): play immediately on entry, then repeat every REMINDER_INTERVAL_MS
    if (moodChanged || (now - lastReminderMs >= REMINDER_INTERVAL_MS)) {
      if (currentMood == MOOD_ANGRY) {
        playAngry();
      } else {
        playTired();
      }
      lastReminderMs = now;
    }
  }

  lastMood = currentMood;
}

void playHappy() {
  // First chirp (rising)
  for (int freq = 800; freq <= 1600; freq += 40) {
    tone(buzzerPin, freq);
    roboEyes.update();
    delay(20);
  }
  noTone(buzzerPin);
  delay(60);

  // Second chirp (higher, bouncy finish)
  for (int freq = 1200; freq <= 2200; freq += 50) {
    tone(buzzerPin, freq);
    roboEyes.update();
    delay(18);
  }
  noTone(buzzerPin);
}

// 2. ANGRY: Low, harsh, erratic frequency jumps with rapid pulsing
void playAngry() {
  for (int i = 0; i < 4; i++) {
    tone(buzzerPin, 280);
    delay(70);
    tone(buzzerPin, 220); // Drops down aggressively
    roboEyes.update();
    delay(70);
  }
  noTone(buzzerPin);
}

// 3. TIRED: Slow, sagging pitch glides that drag downward and fade out
void playTired() {
  for (int freq = 900; freq >= 400; freq -= 15) {
    tone(buzzerPin, freq);
    roboEyes.update();
    delay(25);
  }
  noTone(buzzerPin);

  unsigned long pauseStart = millis();
  while (millis() - pauseStart < 300) {
    roboEyes.update();
  }

  for (int freq = 500; freq >= 200; freq -= 10) {
    tone(buzzerPin, freq);
    roboEyes.update();
    delay(40);
  }
  noTone(buzzerPin);
}
